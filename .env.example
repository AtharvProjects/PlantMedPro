# =============================================================
# PlantMedPro — Environment Variables TEMPLATE
# Copy this file to .env and fill in your real keys.
# This file is safe to commit. .env is NOT.
# =============================================================

# Google Gemini API (required for AI plant diagnosis)
# Free key at: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_KEY=YOUR_GEMINI_API_KEY_HERE

# Supabase (required for history & crop sync)
# Create free project at: https://supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenWeather API (for real weather — 1000 free calls/day)
# Sign up at: https://openweathermap.org/api
EXPO_PUBLIC_OPENWEATHER_KEY=YOUR_OPENWEATHER_KEY

# Roboflow API (secondary AI fallback — optional)
EXPO_PUBLIC_ROBOFLOW_API_KEY=YOUR_ROBOFLOW_KEY
EXPO_PUBLIC_ROBOFLOW_MODEL_ID=plant-disease-classification-dvfsj
EXPO_PUBLIC_ROBOFLOW_MODEL_VERSION=1
